# Airflow Environment Configuration
# Copy this file to .env and fill in your values

# Airflow Home
AIRFLOW_HOME=/opt/airflow

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=airflow
DB_USER=airflow
DB_PASSWORD=airflow

# Executor
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=false

# Encryption key for stored Connections/Variables (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=MKEyKzAxM3dzdThJUkFJLzQzSS1yRW9OMXpiOV91Yz0=

# Logging
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# External API keys (optional — only needed if you swap out the free APIs)
OPENWEATHER_API_KEY=demo
